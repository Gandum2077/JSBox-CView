{
  "name": "jsbox-cview",
  "version": "2.0.0",
  "description": "为 JSBox 设计的微型框架",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gandum2077/JSBox-CView"
  },
  "homepage": "https://github.com/Gandum2077/JSBox-CView",
  "bugs": "https://github.com/Gandum2077/JSBox-CView/issues",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/components",
    "dist/controller",
    "dist/utils",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build:debug": "tsc --outDir ./dist-debug && npx browserify ${npm_config_entry:-./dist-debug/index.js} > test.js",
    "build:examples": "node ./scripts/build-examples.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "npm run build && node --test tests/*.test.cjs",
    "check:package": "node ./scripts/check-package.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build:examples && npm run check:package",
    "prepack": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && npm run build"
  },
  "keywords": [
    "jsbox",
    "typescript",
    "ui",
    "cview"
  ],
  "author": "Gandum2077",
  "license": "MIT",
  "dependencies": {
    "jsbox-types": "^2.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "browserify": "^17.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsdoc": "^63.3.3",
    "prettier": "^3.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
